# Server settings for docker-compose.prod.yml. deploy.sh creates deploy/.env on the
# server automatically the first time; this file only documents the keys.

# Public hostname. sslip.io turns an IP into a hostname: 1.2.3.4 -> 1-2-3-4.sslip.io
DOMAIN=1-2-3-4.sslip.io

# Random, generated on the server (openssl rand -hex 24). Hex only, so it's URL-safe.
POSTGRES_PASSWORD=change-me
