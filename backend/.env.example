# Copy to backend/.env:  cp backend/.env.example backend/.env
# These values match docker-compose.yml for LOCAL development only.
# Never commit backend/.env, and use strong, unique values in production.

# Hostnames "db" and "redis" are the Docker Compose service names.
DATABASE_URL=postgresql+asyncpg://waitwatch:waitwatch@db:5432/waitwatch
REDIS_URL=redis://redis:6379/0

# Optional tunables (defaults shown)
# CACHE_TTL_SECONDS=300
# STALE_AFTER_MINUTES=45
# EXPIRE_JOB_INTERVAL_MINUTES=15
# REPORT_COOLDOWN_SECONDS=600
